{
  "expo": {
    "name": "party-app",
    "slug": "party-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/gather_logo.png",
    "scheme": "partyapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "googleServicesFile": "./GoogleService-Info.plist",
      "bundleIdentifier": "com.partyplanner.partyplannerapp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFA49F",
        "foregroundImage": "./assets/images/gather_adaptive_foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.partyplanner.partyplannerapp",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/gather_logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow gather to select an image for your event."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "cmakeVersion": "4.1.2"
          },
          "ios": {
            "useFrameworks": "dynamic"
          }
        }
      ],
      [
        "@react-native-firebase/messaging",
        {
          "installationIdEnabled": true
        }
      ],
      [
        "@react-native-firebase/app",
        {}
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow gather to use the microphone for dictating messages to Gala.",
          "speechRecognitionPermission": "Allow gather to transcribe your speech into messages to Gala."
        }
      ],
      "./plugins/with-speech-microphone",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
